{
  "name": "launchpad-typescript-workspace",
  "private": true,
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "lint": "oxlint packages",
    "format": "oxfmt package.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json packages",
    "format:check": "oxfmt --check package.json pnpm-workspace.yaml .oxlintrc.json .oxfmtrc.json packages",
    "check": "pnpm run lint && pnpm run format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
