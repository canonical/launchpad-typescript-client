{
  "name": "@canonical/launchpad-typescript-client",
  "version": "0.0.0",
  "license": "LGPL-3.0-only",
  "files": [
    "COPYING",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/primitives": {
      "types": "./dist/schemas/primitives.d.ts",
      "default": "./dist/schemas/primitives.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "pretest:coverage": "pnpm run pretest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --max-warnings 0 src vitest.config.ts",
    "format": "oxfmt 'src/**/*.ts' 'testing/**/*.ts' package.json 'tsconfig*.json' vitest.config.ts",
    "format:check": "oxfmt --check 'src/**/*.ts' 'testing/**/*.ts' package.json 'tsconfig*.json' vitest.config.ts",
    "check": "pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
