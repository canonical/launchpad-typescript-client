{
  "name": "@canonical/launchpad-client",
  "version": "0.0.2",
  "license": "LGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canonical/launchpad-typescript-client.git",
    "directory": "packages/client"
  },
  "files": [
    "CHANGELOG.md",
    "COPYING",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/generated/qastaging/contracts.d.ts",
      "default": "./dist/generated/qastaging/contracts.js"
    },
    "./contracts/production": {
      "types": "./dist/generated/production/contracts.d.ts",
      "default": "./dist/generated/production/contracts.js"
    },
    "./contracts/qastaging": {
      "types": "./dist/generated/qastaging/contracts.d.ts",
      "default": "./dist/generated/qastaging/contracts.js"
    },
    "./schemas/primitives": {
      "types": "./dist/schemas/primitives.d.ts",
      "default": "./dist/schemas/primitives.js"
    },
    "./schemas/models/*": {
      "types": "./dist/generated/qastaging/schemas/models/*.gen.d.ts",
      "default": "./dist/generated/qastaging/schemas/models/*.gen.js"
    },
    "./schemas/operations/*": {
      "types": "./dist/generated/qastaging/schemas/operations/*.gen.d.ts",
      "default": "./dist/generated/qastaging/schemas/operations/*.gen.js"
    },
    "./schemas/production/models/*": {
      "types": "./dist/generated/production/schemas/models/*.gen.d.ts",
      "default": "./dist/generated/production/schemas/models/*.gen.js"
    },
    "./schemas/production/operations/*": {
      "types": "./dist/generated/production/schemas/operations/*.gen.d.ts",
      "default": "./dist/generated/production/schemas/operations/*.gen.js"
    },
    "./schemas/qastaging/models/*": {
      "types": "./dist/generated/qastaging/schemas/models/*.gen.d.ts",
      "default": "./dist/generated/qastaging/schemas/models/*.gen.js"
    },
    "./schemas/qastaging/operations/*": {
      "types": "./dist/generated/qastaging/schemas/operations/*.gen.d.ts",
      "default": "./dist/generated/qastaging/schemas/operations/*.gen.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepack": "pnpm run generate && pnpm run build",
    "generate": "npm --prefix tooling run generate",
    "schema:update": "node tooling/snapshots/refresh.ts",
    "pretest": "pnpm run build && pnpm run test:types",
    "test": "vitest run",
    "pretest:coverage": "pnpm run pretest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.types.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && npm --prefix tooling run typecheck",
    "lint": "oxlint --max-warnings 0 src testing tooling vitest.config.ts",
    "format": "oxfmt 'src/**/*.ts' 'testing/**/*.ts' '!src/generated/**' package.json tooling/package.json 'tooling/**/*.ts' tooling/tsconfig.json 'tsconfig*.json' vitest.config.ts",
    "format:check": "oxfmt --check 'src/**/*.ts' 'testing/**/*.ts' '!src/generated/**' package.json tooling/package.json 'tooling/**/*.ts' tooling/tsconfig.json 'tsconfig*.json' vitest.config.ts",
    "check": "pnpm run lint && pnpm run format:check"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
